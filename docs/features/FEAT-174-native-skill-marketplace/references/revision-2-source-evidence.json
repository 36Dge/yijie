  "findings_basis": {
    "F1": [
      "core-plugins/manager.rs configured_plugin_states filters on config keys before cache existence",
      "installed_version is gated by installed in current listing"
    ],
    "F2": [
      "one marketplace.json contains the full plugins array",
      "plugin/read requires an existing marketplace entry"
    ],
    "F3": [
      "PluginInstallParams has no version argument",
      "local source paths must remain under marketplace root"
    ],
    "F4": [
      "plugin/list and plugin/installed depend on current catalog entries",
      "enabled cached plugins load from configuration independently"
    ],
    "F5": [
      "existing native detailed refresh supports IfVersionChanged and ForceReinstall",
      "refresh preserves enabled configuration and clears caches through manager"
    ],
    "F6": [
      "legacy journal reader accepts only schema 1/2 and closed phases",
      "native skill rules match name/path in ordered config layers",
      "native config APIs expose layers and expectedVersion"
    ]
  },
  "runtime_extensions": "N1/N2/N3 are proposed, not implemented",

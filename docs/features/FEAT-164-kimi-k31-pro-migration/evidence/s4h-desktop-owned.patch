+++ b/scripts/tests/feat164-generation.test.mjs
@@ -0,0 +1,10 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {generationPlan,sourcePins,checkSourceFacts,checkEnvironment,executePlan} from '../check-feat164-generation.mjs';
+function facts(){return Object.fromEntries([['yijie-desktop','a'.repeat(40)],...Object.entries(sourcePins)].map(([name,head])=>[name,{head,dirty:false,realPath:'/qualification/'+name}]))}
+test('accepts a clean same-parent source set without changing product flags',()=>{assert.doesNotThrow(()=>checkSourceFacts(facts()));});
+test('rejects a different qualification tree before any generator can resolve its consumer',()=>{const f=facts();f['yijie-contracts'].realPath='/previous/yijie-contracts';assert.throws(()=>checkSourceFacts(f),/sibling path/);});
+test('rejects changed source or dirty inputs without preparing or overwriting them',()=>{for(const name of Object.keys(facts())){const f=facts();f[name].dirty=true;assert.throws(()=>checkSourceFacts(f));}const f=facts();f['yijie-connectors'].head='b'.repeat(40);assert.throws(()=>checkSourceFacts(f));});
+test('retains every old-reader family and selects only the existing FEAT164 catalog provenance',()=>{const p=generationPlan();assert.equal(p.length,19);assert.equal(new Set(p.map(s=>s.id)).size,p.length);for(const id of ['public-api','host-v2','host-v3','host-skills','host-v4','native-timing','session-purpose','native-conversation','native-source','scheduled-ipc-v1','market-connectors','market-selection-v1','market-provider','market-host-v1','runtime-k31','models-v2','scheduled-ipc-v2','v2-source-closure'])assert(p.some(s=>s.id===id));assert(p.find(s=>s.id==='feat164-catalog').args.includes('--check'));assert(!p.some(s=>s.args.some(a=>a.includes('sync-market-catalog'))));for(const s of p.filter(s=>s.args[0].includes('/generate-')||s.args[0].includes('/sync-')))assert(s.args.includes('--check'));});
+test('credential and redirect settings do not enter source checks',()=>{const e=checkEnvironment({PATH:'/tools',HOME:'/home',KIMI_API_KEY:'synthetic',NODE_OPTIONS:'synthetic',YIJIE_DESKTOP_CONTRACTS_DIR:'/previous',YIJIE_KIMI_K31_CALL_SURFACES:'media'});assert.equal(e.PATH,'/tools');assert.equal(e.YIJIE_KIMI_K31_CALL_SURFACES,'ordinary');for(const k of ['KIMI_API_KEY','NODE_OPTIONS','YIJIE_DESKTOP_CONTRACTS_DIR'])assert.equal(e[k],undefined);});
+test('a failed child status is recorded once and stops the plan',()=>{const seen=[],record=[];assert.equal(executePlan(generationPlan(),s=>{seen.push(s.id);return s.id==='host-v2'?1:0;},(s,r)=>record.push([s.id,r])),false);assert.deepEqual(seen,['public-api','host-v2']);assert.deepEqual(record,[['public-api',0],['host-v2',1]]);});
